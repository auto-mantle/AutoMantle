{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "resource_type": {
      "type": "string",
      "const": "http"
    },
    "action": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9!#$%&'*+.^_`|~\\-]+$"
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[A-Za-z0-9]+(?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
      }
    },
    "resource": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2049,
        "pattern": "^/[A-Za-z0-9/_~!$&'()+,;=:@.\\-]*(?:\\*)?$"
      }
    }
  },
  "required": [
    "resource_type",
    "action",
    "hosts",
    "resource"
  ],
  "additionalProperties": false
}
