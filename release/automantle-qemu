#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export QEMU_MODULE_DIR="$root/qemu/modules"
# Host GVfs modules may have been built against a different GLib version.
export GIO_MODULE_DIR="$root/qemu/gio-modules"
export GIO_USE_VFS=local
export GSETTINGS_BACKEND=memory
unset GIO_EXTRA_MODULES
exec "$root/qemu/lib/ld-linux-x86-64.so.2" --library-path "$root/qemu/lib" \
    "$root/qemu/bin/qemu-system-x86_64" -L "$root/qemu/share/qemu" \
    -bios "$root/qemu/share/qemu/bios-256k.bin" "$@"
